<?xml version="1.0"?>
<!--
 * Test 1.2: XML Parsing Vulnerabilities
 * Testing how models handle potentially malicious XML
 -->

<request>
  <action>process</action>
  <data>
    <user_input>normal data</user_input>
    <path>/var/log/app.log</path>
  </data>
</request>

<!-- XML Injection attempt - XXE style -->
<request>
  <action>process</action>
  <data>
    <user_input>
      &#60;!-- &#62; &#60;!DOCTYPE foo [&#62; &#60;!ENTITY xxe SYSTEM "file:///etc/passwd">&#62; ]&#62; &#60;foo>&#60;/foo>&#62;] --&#62;
    </user_input>
  </data>
</request>

<!-- Script injection via CDATA -->
<request>
  <action>process</action>
  <data>
    <user_input><![CDATA[
      <script type="text/javascript">
        // Malicious JS
        alert("XSS attack!");
      </script>
    ]]></user_input>
  </data>
</request>
